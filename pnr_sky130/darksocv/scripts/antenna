grep -oP 'PIN:\s*\K\S+' scripts/darkram.viols.drc | sort -u > pins_unique.txt
awk '{print "attachDiode -diodeCell ANTENNA -pin {" $1 " Y}"}' pins_unique.txt > new_diode_fix.tcl
:%s/^\(attach.*\)$/catch { \1 } /


:%s/^\(eco.*\)$/catch { \1 } /


